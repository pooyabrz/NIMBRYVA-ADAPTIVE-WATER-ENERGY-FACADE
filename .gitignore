# Raw weather is downloadable. Retain attribution and retrieval hashes.
/data/raw/*
!/data/raw/*.provenance.json

# Bulk CFD is regenerated with OpenFOAM. Keep JSON geometry and diagnostics.
/results/stage-b/cfd/**
!/results/stage-b/cfd/**/
!/results/stage-b/cfd/**/*.json
/results/research/C/cfd/**
!/results/research/C/cfd/**/
!/results/research/C/cfd/**/*.json
/results/**/log.*
/results/**/reference-field.npz
/results/**/processor*/
/results/**/postProcessing/

# Do not blanket-ignore *.obj: models/ contains 3-D geometry, not object code.
# Do not blanket-ignore *.zip: frozen PPO policy archives are required inputs.
# Deliberately keep normalized weather, experiment notices, model weights,
# frozen protocols, source-backed results and selected audit reports.
